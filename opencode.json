{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "architect",
  "instructions": ["AGENTS.md"],
  "permissions": [
    {
      "action": "edit",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env.local",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env.*.local",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env.example",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "AGENTS.md",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "docker compose down -v*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
